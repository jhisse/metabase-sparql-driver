# UNESCO World Heritage Sites, one point per listed site
SELECT ?whs ?name ?country ?latitude ?longitude WHERE {
  {
    SELECT ?whs (SAMPLE(?site) AS ?item) (SAMPLE(?c) AS ?countryItem)
           (SAMPLE(?lat) AS ?latitude) (SAMPLE(?lon) AS ?longitude) WHERE {
      ?site p:P1435 ?listing ; wdt:P757 ?whsId ; wdt:P17 ?c ;
            p:P625/psv:P625 [ wikibase:geoLatitude ?lat ; wikibase:geoLongitude ?lon ] .
      ?listing ps:P1435 wd:Q9259 .
      FILTER NOT EXISTS { ?listing pq:P582 ?removed }
      FILTER (!CONTAINS(?whsId, "-"))
      BIND (REPLACE(?whsId, "[^0-9].*$", "") AS ?whs)
    }
    GROUP BY ?whs
  }
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
    ?item rdfs:label ?name .
    ?countryItem rdfs:label ?country .
  }
}
