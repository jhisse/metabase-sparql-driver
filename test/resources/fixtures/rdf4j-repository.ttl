# Config of the in-memory RDF4J repository the smoke suite runs on. bin/lib.sh
# (SPARQL_ENGINE=rdf4j) PUTs it to /rdf4j-server/repositories/smoke once the
# server is up, before seeding the fixture.
@prefix config: <tag:rdf4j.org,2023:config/> .

[] a config:Repository ;
   config:rep.id "smoke" ;
   config:rep.impl [
       config:rep.type "openrdf:SailRepository" ;
       config:sail.impl [ config:sail.type "openrdf:MemoryStore" ]
   ] .
